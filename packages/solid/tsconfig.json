{
  "compilerOptions": {
    "allowJs": false,
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "module": "ESNext",
    "moduleResolution": "node",
    "outDir": "dist",
    "strict": true,
    "strictNullChecks": true,
    "target": "ESNext",
    "types": ["vite/client", "solid-js"]
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
