{
  "name": "nodeflow-root",
  "private": true,
  "author": "LordDeatHunter",
  "repository": {
    "type": "git",
    "url": "https://github.com/LordDeatHunter/nodeflow"
  },
  "homepage": "https://lorddeathunter.github.io/nodeflow",
  "version": "0.0.9",
  "description": "Library for creating node/graph-based applications",
  "scripts": {
    "build-examples": "node scripts/build-examples.cjs",
    "dev:landing": "bun run scripts/dev-landing.ts",
    "dev:blueprint": "bun --cwd=./examples/BlueprintApp run start",
    "dev:familytree": "bun --cwd=./examples/FamilyTreeApp run start",
    "dev:nostyle": "bun --cwd=./examples/NoStyle run start",
    "dev:react": "bun --cwd=./examples/ReactApp run start",
    "dev:svelte": "bun --cwd=./examples/SvelteApp run start",
    "dev:vue": "bun --cwd=./examples/VueApp run start",
    "dev:vanilla": "bun --cwd=./examples/VanillaApp run start",
    "lint": "eslint .",
    "test": "bunx turbo test",
    "typecheck": "turbo typecheck",
    "dev": "run-p \"dev:*\"",
    "start": "run-p \"dev:*\"",
    "publish:packages": "bun install && bunx turbo build && bun --cwd=packages/core publish && bun --cwd=packages/solid publish && bun --cwd=packages/vanilla publish && bun --cwd=packages/react publish && bun --cwd=packages/vue publish && bun --cwd=packages/svelte publish"
  },
  "type": "module",
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.16.11",
    "eslint": "^10.15.0",
    "eslint-plugin-solid": "^0.20.1",
    "globals": "^17.14.0",
    "npm-run-all": "^4.1.5",
    "prettier": "3.0.3",
    "rollup": "^4.24.0",
    "rollup-plugin-typescript2": "^0.36.0",
    "rollup-preset-solid": "^2.0.1",
    "sass": "^1.79.5",
    "solid-devtools": "^0.27.9",
    "turbo": "latest",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^4.5.5",
    "vite-plugin-dts": "^4.3.0",
    "vite-plugin-solid": "2.7.0",
    "vite-plugin-terminal": "^1.2.0"
  }
}
