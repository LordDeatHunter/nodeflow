{
  "name": "@nodeflow/react",
  "version": "0.0.1",
  "description": "React wrapper for @nodeflow/vanilla",
  "type": "module",
  "main": "./dist/index.cjs.js",
  "module": "./dist/index.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js"
    }
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "typescript": "^5.6.3",
    "vite": "^4.5.5",
    "vite-plugin-dts": "^4.3.0"
  },
  "peerDependencies": {
    "@nodeflow/vanilla": "workspace:*",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  }
}
